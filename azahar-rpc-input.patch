+bool RPCServer::ReplyInput(Packet& packet) {
+    const auto hid = Service::HID::GetModule(system);
+    if (!hid) {
+        return false;
+    }
+    const Service::HID::ScriptedInput scripted = hid->GetScriptedInput();
+
+    InputFlags flags{};
+    if (scripted.circle_pad_active) {
+        flags |= InputFlags::CirclePad;
+    }
+    if (scripted.touch_active) {
+        flags |= InputFlags::Touch;
+    }
+    const InputInfo info{
+        .held =
+            {
+                .buttons = scripted.buttons,
+                .circle_x = scripted.circle_pad_x,
+                .circle_y = scripted.circle_pad_y,
+                .touch_x = scripted.touch_x,
+                .touch_y = scripted.touch_y,
+                .flags = static_cast<u32>(flags),
+            },
+        .pad_state = hid->GetState().hex,
+        .pad_updates = hid->GetPadUpdateCount(),
+    };
+    std::memcpy(packet.GetPacketData().data(), &info, sizeof(info));
+    packet.SetPacketDataSize(sizeof(info));
+    packet.SendReply();
+    return true;
+}
+
+bool RPCServer::HandleSetInput(Packet& packet, const InputState& input) {
+    const auto hid = Service::HID::GetModule(system);
+    if (!hid) {
+        LOG_ERROR(RPC_Server, "HID is not available, no game running?");
+        return false;
+    }
+    const auto flags = static_cast<InputFlags>(input.flags);
+    hid->SetScriptedInput({
+        .buttons = input.buttons,
+        .circle_pad_active = True(flags & InputFlags::CirclePad),
+        .circle_pad_x = input.circle_x,
+        .circle_pad_y = input.circle_y,
+        .touch_active = True(flags & InputFlags::Touch),
+        .touch_x = input.touch_x,
+        .touch_y = input.touch_y,
+    });
+    return ReplyInput(packet);
+}
