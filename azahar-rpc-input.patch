+constexpr u16 DEFAULT_PORT = 45987;
+
+/// The port can be set per process with the AZAHAR_RPC_PORT environment variable, so that
+/// several instances can run on one machine.
+static u16 GetPort() {
+    const char* env = std::getenv("AZAHAR_RPC_PORT");
+    if (env == nullptr || *env == '\0') {
+        return DEFAULT_PORT;
+    }
+    char* end = nullptr;
+    const unsigned long port = std::strtoul(env, &end, 10);
+    if (*end != '\0' || port == 0 || port > 65535) {
+        LOG_ERROR(RPC_Server, "Invalid AZAHAR_RPC_PORT '{}', using {}", env, DEFAULT_PORT);
+        return DEFAULT_PORT;
+    }
+    return static_cast<u16>(port);
+}
